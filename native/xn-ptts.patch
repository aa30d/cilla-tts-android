+    pub fn speak_raw(
+        &mut self,
+        text: &str,
+        frames_after_eos: usize,
+        sink: &mut dyn FnMut(&[f32]) -> bool,
+    ) -> Result<PttsResult, String> {
+        let start = std::time::Instant::now();
+        let tokens = self.tokenizer.encode(text).map_err(|e| e.to_string())?;
+        if tokens.is_empty() {
+            return Err("nothing to synthesize: no tokens".to_string());
+        }
+        let budget_tokens = (tokens.len() + 2).min(ptts::plan::MAX_FIT_TOKENS);
+        let opts = SpeechOptions {
+            voice: self.voice.clone(),
+            temperature: self.temperature,
+            seed: self.seed,
+            max_tokens_per_chunk: Some(budget_tokens),
+            ..Default::default()
+        };
+        let session = if tokens.len() + 2 <= ptts::plan::MAX_FIT_TOKENS {
+            self.synth.session_default(&opts).map_err(|e| e.to_string())?
+        } else {
+            let cfg = self.synth.config();
+            let frame_rate = cfg.mimi.frame_rate;
+            let prompt_frames =
+                (cfg.audio_prompt_max_duration.ceil() as usize) * (frame_rate.ceil() as usize);
+            let seq_budget = prompt_frames.max(ptts::plan::PROMPT_SEQ_HEADROOM)
+                + tokens.len()
+                + ptts::plan::frame_budget(tokens.len(), frame_rate)
+                + 16;
+            self.synth.session(&opts, seq_budget).map_err(|e| e.to_string())?
+        };
+        let temp = self.temperature.unwrap_or(0.7);
+        let seed = self.seed.unwrap_or(4242424242424242);
+        let rng = Box::new(NormalRng::new(temp, seed).map_err(|e| e.to_string())?);
+        let stream =
+            session.stream_tokens(tokens, frames_after_eos, rng).map_err(|e| e.to_string())?;
+        let (mut samples, mut ttfa) = (0, None);
+        for pcm in stream {
+            let pcm = pcm.map_err(|e| e.to_string())?;
+            if pcm.is_empty() {
+                continue;
+            }
+            ttfa.get_or_insert(start.elapsed());
+            samples += pcm.len();
+            if !sink(&pcm) {
+                break;
+            }
+        }
+        Ok(PttsResult {
+            frames: samples.div_ceil(self.frame_size) as u32,
+            samples,
+            ttfa_ms: ttfa.unwrap_or_default().as_secs_f64() * 1e3,
+            total_ms: start.elapsed().as_secs_f64() * 1e3,
+        })
+    }
+}
