+/// Speak `text` as a single pre-normalized chunk without `prepare_text_prompt` and with explicit
+/// `frames_after_eos` (e.g. `0` for Cilla Lite). Returns false on failure; see `ptts_last_error`.
+///
+/// # Safety
+/// `h` must come from `ptts_new`; `text` must be NUL-terminated UTF-8; `cb` must be valid for
+/// the duration of the call; `out` must be writable.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_speak_raw(
+    h: *mut PttsHandle,
+    text: *const c_char,
+    frames_after_eos: u32,
+    cb: PttsFrameFn,
+    user: *mut c_void,
+    out: *mut PttsResult,
+) -> bool {
+    if h.is_null() || text.is_null() || out.is_null() {
+        LAST_ERROR.with(|l| *l.borrow_mut() = Some(c_string("null argument to ptts_speak_raw")));
+        return false;
+    }
+    let h = unsafe { &mut *h };
+    let text = unsafe { CStr::from_ptr(text) }.to_string_lossy().to_string();
+    #[cfg(not(target_vendor = "apple"))]
+    let r = guarded(|| {
+        h.engine.speak_raw(
+            &text,
+            frames_after_eos as usize,
+            &mut |pcm: &[f32]| cb(pcm.as_ptr(), pcm.len(), user),
+        )
+    });
+    #[cfg(target_vendor = "apple")]
+    let r: Result<PttsResult, String> = {
+        let _ = (text, frames_after_eos, cb, user);
+        Err("ptts_speak_raw is only supported on CPU".to_string())
+    };
+    match r {
+        Ok(r) => {
+            unsafe { *out = r };
+            true
+        }
+        Err(e) => {
+            h.last_error = Some(c_string(&e));
+            false
+        }
+    }
+}
+
+/// Token count of `text` under the checkpoint's tokenizer, or -1 on failure.
+///
+/// # Safety
+/// `h` must come from `ptts_new`; `text` must be NUL-terminated UTF-8.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_count_tokens(h: *mut PttsHandle, text: *const c_char) -> i32 {
+    if h.is_null() || text.is_null() {
+        return -1;
+    }
+    let h = unsafe { &mut *h };
+    let text = unsafe { CStr::from_ptr(text) }.to_string_lossy().to_string();
+    #[cfg(not(target_vendor = "apple"))]
+    let r = guarded(|| h.engine.count_tokens(&text));
+    #[cfg(target_vendor = "apple")]
+    let r: Result<usize, String> = {
+        let _ = text;
+        Err("ptts_count_tokens is only supported on CPU".to_string())
+    };
+    match r {
+        Ok(n) => i32::try_from(n).unwrap_or(i32::MAX),
+        Err(e) => {
+            h.last_error = Some(c_string(&e));
+            -1
+        }
+    }
+}
+
+/// True when the loaded checkpoint carries a speaker encoder for voice cloning.
+///
+/// # Safety
+/// `h` must be null or come from `ptts_new`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_supports_voice_cloning(h: *const PttsHandle) -> bool {
+    if h.is_null() {
+        return false;
+    }
+    #[cfg(not(target_vendor = "apple"))]
+    {
+        unsafe { (*h).engine.supports_voice_cloning() }
+    }
+    #[cfg(target_vendor = "apple")]
+    {
+        false
+    }
+}
+
+/// Register a `.safetensors` voice file on a live handle under `name`, updating `ptts_voices`.
+///
+/// # Safety
+/// `h` must come from `ptts_new`; `name` and `path` must be NUL-terminated UTF-8.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_add_voice_file(
+    h: *mut PttsHandle,
+    name: *const c_char,
+    path: *const c_char,
+) -> bool {
+    if h.is_null() || name.is_null() || path.is_null() {
+        LAST_ERROR
+            .with(|l| *l.borrow_mut() = Some(c_string("null argument to ptts_add_voice_file")));
+        return false;
+    }
+    let h = unsafe { &mut *h };
+    let name = unsafe { CStr::from_ptr(name) }.to_string_lossy().to_string();
+    let path = unsafe { CStr::from_ptr(path) }.to_string_lossy().to_string();
+    #[cfg(not(target_vendor = "apple"))]
+    let r = guarded(|| h.engine.add_voice_file(&name, Path::new(&path)));
+    #[cfg(target_vendor = "apple")]
+    let r: Result<(), String> = {
+        let _ = (name, path);
+        Err("ptts_add_voice_file is only supported on CPU".to_string())
+    };
+    match r {
+        Ok(()) => {
+            h.voice_blob = nul_separated(h.engine.voices());
+            true
+        }
+        Err(e) => {
+            h.last_error = Some(c_string(&e));
+            false
+        }
+    }
+}
+
+/// Encode mono f32 PCM at `sample_rate` Hz using the checkpoint's speaker encoder and write an
+/// `"emb"` `.safetensors` voice file to `output_path`. On failure returns false and sets
+/// `ptts_last_error(NULL)` on the calling thread. `frames`/`dim`, when given, receive the
+/// embedding's frame count and width.
+///
+/// # Safety
+/// `model_dir` and `output_path` must be NUL-terminated UTF-8; `pcm` must point to at least
+/// `n_samples` readable `f32` values; `frames` and `dim` must be null or writable.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_clone_voice_to_file(
+    model_dir: *const c_char,
+    pcm: *const f32,
+    n_samples: usize,
+    sample_rate: u32,
+    output_path: *const c_char,
+    normalize_loudness: bool,
+    frames: *mut u32,
+    dim: *mut u32,
+) -> bool {
+    if model_dir.is_null() || pcm.is_null() || output_path.is_null() || n_samples == 0 {
+        LAST_ERROR.with(|l| {
+            *l.borrow_mut() = Some(c_string("invalid argument to ptts_clone_voice_to_file"))
+        });
+        return false;
+    }
+    let model_dir = unsafe { CStr::from_ptr(model_dir) }.to_string_lossy().to_string();
+    let output_path = unsafe { CStr::from_ptr(output_path) }.to_string_lossy().to_string();
+    let pcm = unsafe { std::slice::from_raw_parts(pcm, n_samples) };
+    #[cfg(not(target_vendor = "apple"))]
+    let r = guarded(|| {
+        cpu::clone_voice_to_file(
+            Path::new(&model_dir),
+            pcm,
+            sample_rate,
+            Path::new(&output_path),
+            normalize_loudness,
+        )
+    });
+    #[cfg(target_vendor = "apple")]
+    let r: Result<(), String> = {
+        let _ = (model_dir, output_path, pcm, sample_rate, normalize_loudness, frames, dim);
+        Err("ptts_clone_voice_to_file is only supported on CPU".to_string())
+    };
+    match r {
+        Ok(()) => {
+            #[cfg(not(target_vendor = "apple"))]
+            {
+                if !frames.is_null() {
+                    unsafe { *frames = info.frames as u32 };
+                }
+                if !dim.is_null() {
+                    unsafe { *dim = info.dim as u32 };
+                }
+            }
+            true
+        }
+        Err(e) => {
+            LAST_ERROR.with(|l| *l.borrow_mut() = Some(c_string(&e)));
+            false
+        }
+    }
+}
+
+/// Clone several voices in one call, so the checkpoint's weights are loaded once for the batch.
+///
+/// `names` holds `count` NUL-terminated UTF-8 voice names; `pcm` holds their samples
+/// back to back, the `i`-th starting at `offsets[i]` and ending at `offsets[i + 1]`
+/// (`offsets` has `count + 1` entries). Every prompt must already be at the checkpoint's prompt
+/// sample rate. On success `written` is set to the number of `<name>.safetensors` files written to
+/// `voices_dir`, and `failed` (when not NULL) receives a NUL-separated, NUL-terminated list of the
+/// remaining names -- the ones that could not be encoded. Free it with
+/// [`ptts_strings_free`]. Returns false, with `ptts_last_error(NULL)` set, only when the batch
+/// cannot be attempted at all.
+///
+/// # Safety
+/// `model_dir` and `voices_dir` must be NUL-terminated UTF-8; `names` must hold `count` NUL-
+/// terminated strings; `pcm` must hold `offsets[count]` readable `f32` values; `offsets` must
+/// hold `count + 1` readable `size_t` values; `written` must be writable.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_clone_voices_to_dir(
+    model_dir: *const c_char,
+    voices_dir: *const c_char,
+    names: *const *const c_char,
+    count: usize,
+    pcm: *const f32,
+    offsets: *const usize,
+    normalize_loudness: bool,
+    written: *mut u32,
+    failed: *mut *mut c_char,
+) -> bool {
+    if model_dir.is_null()
+        || voices_dir.is_null()
+        || names.is_null()
+        || pcm.is_null()
+        || offsets.is_null()
+        || written.is_null()
+    {
+        LAST_ERROR.with(|l| {
+            *l.borrow_mut() = Some(c_string("invalid argument to ptts_clone_voices_to_dir"))
+        });
+        return false;
+    }
+    let model_dir = unsafe { CStr::from_ptr(model_dir) }.to_string_lossy().to_string();
+    let voices_dir = unsafe { CStr::from_ptr(voices_dir) }.to_string_lossy().to_string();
+    let samples = unsafe { std::slice::from_raw_parts(offsets, count + 1) };
+    let pcm = unsafe { std::slice::from_raw_parts(pcm, samples[count]) };
+    if samples.windows(2).any(|w| w[0] > w[1]) {
+        LAST_ERROR.with(|l| {
+            *l.borrow_mut() = Some(c_string("offsets to ptts_clone_voices_to_dir are not sorted"))
+        });
+        return false;
+    }
+    let prompts = (0..count)
+        .map(|i| {
+            let name = unsafe { CStr::from_ptr(*names.add(i)) }.to_string_lossy().to_string();
+            // A bad slice index would unwind through the C ABI, so it is reported instead.
+            let samples = pcm.get(samples[i]..samples[i + 1]).unwrap_or(&[]).to_vec();
+            (name, samples)
+        })
+        .collect::<Vec<_>>();
+    #[cfg(not(target_vendor = "apple"))]
+    let r = guarded(|| {
+        cpu::clone_voices_from_audio(
+            Path::new(&model_dir),
+            Path::new(&voices_dir),
+            &prompts,
+            normalize_loudness,
+        )
+    });
+    #[cfg(target_vendor = "apple")]
+    let r: Result<(Vec<String>, Vec<(String, String)>), String> = {
+        let _ = (model_dir, voices_dir, prompts, normalize_loudness);
+        Err("ptts_clone_voices_to_dir is only supported on CPU".to_string())
+    };
+    match r {
+        Ok((ok_names, failures)) => {
+            for (name, reason) in &failures {
+                tracing::warn!("voice {name} was not written: {reason}");
+            }
+            unsafe { *written = ok_names.len() as u32 };
+            if !failed.is_null() {
+                let names: Vec<String> = failures.into_iter().map(|(name, _)| name).collect();
+                unsafe { *failed = nul_separated_c(names) };
+            }
+            true
+        }
+        Err(e) => {
+            LAST_ERROR.with(|l| *l.borrow_mut() = Some(c_string(&e)));
+            false
+        }
+    }
+}
+
+/// Free the string [`ptts_clone_voices_to_dir`] returned.
+///
+/// # Safety
+/// `s` must be null or come from `ptts_clone_voices_to_dir`, and must not be used afterwards.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_strings_free(s: *mut c_char) {
+    if !s.is_null() {
+        drop(unsafe { CString::from_raw(s) });
+    }
+}
+
+/// [`nul_separated`] as an owned C string the caller frees with [`ptts_strings_free`]. The bytes
+/// form a valid `CString` by construction: names are UTF-8 without NUL and each is terminated.
+fn nul_separated_c(names: Vec<String>) -> *mut c_char {
+    match CString::new(nul_separated(&names)) {
+        Ok(s) => s.into_raw(),
+        Err(_) => std::ptr::null_mut(),
+    }
+}
