+/// What a cloned voice file holds: the embedding's frames and width, so the caller can check the
+/// file against the checkpoint without reading it back.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct CloneInfo {
+    pub frames: usize,
+    pub dim: usize,
+}
+
+/// The checkpoint's speaker encoder, for cloning voices from audio.
+fn load_speaker_encoder(
+    model_dir: &Path,
+    cfg: &ptts::tts_model::TTSConfig,
+) -> Result<MimiEnc<xn::Unquantized<f32, xn::CpuDevice>>, String> {
+    // Prefer f32 safetensors because quantized GGUFs typically omit the speaker encoder.
+    let weights_path = ["model.safetensors", "model.q8.gguf"]
+        .iter()
+        .map(|name| model_dir.join(name))
+        .find(|p| p.is_file())
+        .ok_or_else(|| format!("no weights in {}", model_dir.display()))?;
+    let dev = xn::CpuDevice;
+    let vb = ptts::loader::load_weights::<xn::Unquantized<f32, xn::CpuDevice>>(&weights_path, &dev)
+        .map_err(|e| e.to_string())?;
+    // `Synth::prime` requires this weight, so check for it before the encoder reports some other,
+    // more confusing error (`MimiEnc::load` already says so, but only after loading the encoder).
+    if !vb.contains(ptts::loader::SPEAKER_PROJ_WEIGHT) {
+        return Err(format!(
+            "{} has no speaker projection ({}): this checkpoint can speak but cannot clone a \
+             voice. A GGUF written with `quantize --no-mimi-encoder` is the usual cause.",
+            weights_path.display(),
+            ptts::loader::SPEAKER_PROJ_WEIGHT
+        ));
+    }
+    let enc = MimiEnc::load(&vb, cfg).map_err(|e| e.to_string())?;
+    drop(vb);
+    Ok(enc)
+}
+
+/// Encode one prompt and write it as a voice file.
+///
+/// When the checkpoint's guidance null branch is conditioned on silence (`cfg_null_audio_empty`
+/// is false), the encoding of the same-length silence is written too, as `null_emb`: a voice file
+/// without it cannot be used for guided generation on such a checkpoint (`Synth::prime` refuses).
+/// Both tensors are f32, which is what `loader::load_voice_emb` reads them as.
+fn write_voice_file(
+    cfg: &ptts::tts_model::TTSConfig,
+    enc: &MimiEnc<xn::Unquantized<f32, xn::CpuDevice>>,
+    pcm: &[f32],
+    output_path: &Path,
+) -> Result<CloneInfo, String> {
+    let dev = xn::CpuDevice;
+    let pcm_tensor =
+        xn::Tensor::from_vec(pcm.to_vec(), (1, 1, ()), &dev).map_err(|e| e.to_string())?;
+    let emb = enc.encode_audio(&pcm_tensor).map_err(|e| e.to_string())?;
+    let mut tensors = HashMap::from([("emb".to_string(), xn::TypedTensor::F32(emb))]);
+    let frames = match tensors.get("emb") {
+        Some(xn::TypedTensor::F32(t)) => t.dims3().map_err(|e| e.to_string())?.1,
+        _ => return Err("speaker encoder returned no embedding".to_string()),
+    };
+    if !cfg.cfg_null_audio_empty {
+        let silent = pcm_tensor.zeros_like().map_err(|e| e.to_string())?;
+        let null_emb = enc.encode_audio(&silent).map_err(|e| e.to_string())?;
+        tensors.insert("null_emb".to_string(), xn::TypedTensor::F32(null_emb));
+    }
+    // `model_ext` tags the file with the checkpoint that made it; `loader::check_model_ext` then
+    // refuses it in a checkpoint listed under another `embeddings_ext`. A config with no
+    // `model_id` (pocket-tts ones, before CillaLiteConverter adds one) has no tag to write.
+    let data_info = cfg
+        .model_ext()
+        .map(|ext| HashMap::from([("model_ext".to_string(), ext)]));
+    if let Some(parent) = output_path.parent() {
+        if !parent.as_os_str().is_empty() {
+            std::fs::create_dir_all(parent).map_err(|e| e.to_string())?;
+        }
+    }
+    let mut tmp_name = output_path.as_os_str().to_os_string();
+    tmp_name.push(".tmp");
+    let tmp_path = PathBuf::from(tmp_name);
+    if let Err(e) = xn::safetensors::save_with_data_info(&tensors, data_info, &tmp_path) {
+        let _ = std::fs::remove_file(&tmp_path);
+        return Err(e.to_string());
+    }
+    if let Err(e) = std::fs::rename(&tmp_path, output_path) {
+        let _ = std::fs::remove_file(&tmp_path);
+        return Err(e.to_string());
+    }
+    Ok(CloneInfo { frames, dim: cfg.flow_lm.d_model })
+}
+
+/// Check a prompt's length against the checkpoint's bounds and trim it to the maximum, as
+/// `Synth::add_voice_from_pcm` does. The caller normalizes loudness beforehand.
+fn prompt_samples(
+    cfg: &ptts::tts_model::TTSConfig,
+    pcm: &[f32],
+    speaker_sr: u32,
+) -> Result<Vec<f32>, String> {
+    let min_len = (speaker_sr as f32 * cfg.audio_prompt_min_duration).round() as usize;
+    let max_len = (speaker_sr as f32 * cfg.audio_prompt_max_duration).round() as usize;
+    if pcm.len() < min_len {
+        return Err(format!(
+            "voice prompt is too short: got {:.2}s, need at least {:.2}s",
+            pcm.len() as f32 / speaker_sr as f32,
+            cfg.audio_prompt_min_duration
+        ));
+    }
+    Ok(pcm[..pcm.len().min(max_len)].to_vec())
+}
+
+/// Encode mono f32 PCM with the checkpoint's speaker encoder and save an `"emb"` safetensors file.
+///
+/// Loads the checkpoint's weights on its own; for more than one prompt use
+/// [`clone_voices_from_audio`], which loads them once for the whole batch.
+pub fn clone_voice_to_file(
+    model_dir: &Path,
+    pcm: &[f32],
+    sample_rate: u32,
+    output_path: &Path,
+    normalize_loudness: bool,
+) -> Result<CloneInfo, String> {
+    let cfg = read_config(&model_dir.join("config.json")).map_err(|e| e.to_string())?;
+    let speaker_sr = cfg.speaker_mimi_cfg().sample_rate as u32;
+    if sample_rate != speaker_sr {
+        return Err(format!(
+            "voice prompt sample rate is {sample_rate} Hz, expected {speaker_sr} Hz"
+        ));
+    }
+    let mut pcm = prompt_samples(&cfg, pcm, speaker_sr)?;
+    if normalize_loudness {
+        ptts::utils::normalize_loudness(&mut pcm, speaker_sr).map_err(|e| e.to_string())?;
+    }
+    let enc = load_speaker_encoder(model_dir, &cfg)?;
+    write_voice_file(&cfg, &enc, &pcm, output_path)
+}
+
+/// Encode several prompts against one loaded speaker encoder: `<name>.safetensors` per voice in
+/// `voices_dir`. The prompts are already at the checkpoint's prompt sample rate (the app decodes
+/// and resamples them with `AudioDecoder`).
+///
+/// Returns the names written, in order, and `(name, reason)` for the ones that could not be
+/// encoded. `Err` is reserved for the whole batch being impossible (no config, no weights,
+/// no speaker encoder); one malformed prompt does not fail the others.
+pub fn clone_voices_from_audio(
+    model_dir: &Path,
+    voices_dir: &Path,
+    prompts: &[(String, Vec<f32>)],
+    normalize_loudness: bool,
+) -> Result<(Vec<String>, Vec<(String, String)>), String> {
+    let cfg = read_config(&model_dir.join("config.json")).map_err(|e| e.to_string())?;
+    let speaker_sr = cfg.speaker_mimi_cfg().sample_rate as u32;
+    let enc = load_speaker_encoder(model_dir, &cfg)?;
+    std::fs::create_dir_all(voices_dir).map_err(|e| e.to_string())?;
+    let mut written = Vec::new();
+    let mut failed = Vec::new();
+    for (name, pcm) in prompts {
+        let mut pcm = match prompt_samples(&cfg, pcm, speaker_sr) {
+            Ok(pcm) => pcm,
+            Err(e) => {
+                failed.push((name.clone(), e));
+                continue;
+            }
+        };
+        if normalize_loudness {
+            if let Err(e) = ptts::utils::normalize_loudness(&mut pcm, speaker_sr) {
+                failed.push((name.clone(), e.to_string()));
+                continue;
+            }
+        }
+        let path = voices_dir.join(format!("{name}.safetensors"));
+        match write_voice_file(&cfg, &enc, &pcm, &path) {
+            Ok(_) => written.push(name.clone()),
+            Err(e) => failed.push((name.clone(), e)),
+        }
+    }
+    Ok((written, failed))
 }
 
