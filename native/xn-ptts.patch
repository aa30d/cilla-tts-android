+/// Encode mono f32 PCM with the checkpoint's speaker encoder and save an `"emb"` safetensors file.
+pub fn clone_voice_to_file(
+    model_dir: &Path,
+    pcm: &[f32],
+    sample_rate: u32,
+    output_path: &Path,
+    normalize_loudness: bool,
+) -> Result<(), String> {
+    let config = model_dir.join("config.json");
+    let cfg = read_config(&config).map_err(|e| e.to_string())?;
+    let speaker_sr = cfg.speaker_mimi_cfg().sample_rate as u32;
+    if sample_rate != speaker_sr {
+        return Err(format!(
+            "voice prompt sample rate is {sample_rate} Hz, expected {speaker_sr} Hz"
+        ));
+    }
+    let min_dur = cfg.audio_prompt_min_duration.min(1.0).max(0.5);
+    let max_dur = cfg.audio_prompt_max_duration.max(15.0).min(30.0);
+    let min_len = (speaker_sr as f32 * min_dur).round() as usize;
+    let max_len = (speaker_sr as f32 * max_dur).round() as usize;
+    if pcm.len() < min_len {
+        return Err(format!(
+            "voice prompt is too short: got {:.2}s, need at least {:.2}s",
+            pcm.len() as f32 / speaker_sr as f32,
+            min_dur
+        ));
+    }
+    let mut pcm = pcm[..pcm.len().min(max_len)].to_vec();
+    if normalize_loudness {
+        ptts::utils::normalize_loudness(&mut pcm, speaker_sr).map_err(|e| e.to_string())?;
+    }
+    // Prefer f32 safetensors because quantized GGUFs typically omit the speaker encoder.
+    let weights = ["model.safetensors", "model.q8.gguf"]
+        .iter()
+        .map(|name| model_dir.join(name))
+        .find(|p| p.is_file())
+        .ok_or_else(|| format!("no weights in {}", model_dir.display()))?;
+    let dev = xn::CpuDevice;
+    let vb = ptts::loader::load_weights::<xn::Unquantized<f32, xn::CpuDevice>>(&weights, &dev)
+        .map_err(|e| e.to_string())?;
+    let mimi_enc: MimiEnc<xn::Unquantized<f32, xn::CpuDevice>> =
+        MimiEnc::load(&vb, &cfg).map_err(|e| e.to_string())?;
+    let pcm_tensor = xn::Tensor::from_vec(pcm, (1, 1, ()), &dev).map_err(|e| e.to_string())?;
+    let emb = mimi_enc.encode_audio(&pcm_tensor).map_err(|e| e.to_string())?;
+    let tensors = HashMap::from([("emb".to_string(), xn::TypedTensor::F32(emb))]);
+    let data_info = cfg
+        .model_ext()
+        .map(|ext| HashMap::from([("model_ext".to_string(), ext)]));
+    if let Some(parent) = output_path.parent() {
+        if !parent.as_os_str().is_empty() {
+            std::fs::create_dir_all(parent).map_err(|e| e.to_string())?;
+        }
+    }
+    let mut tmp_name = output_path.as_os_str().to_os_string();
+    tmp_name.push(".tmp");
+    let tmp_path = PathBuf::from(tmp_name);
+    if let Err(e) = xn::safetensors::save_with_data_info(&tensors, data_info, &tmp_path) {
+        let _ = std::fs::remove_file(&tmp_path);
+        return Err(e.to_string());
+    }
+    if let Err(e) = std::fs::rename(&tmp_path, output_path) {
+        let _ = std::fs::remove_file(&tmp_path);
+        return Err(e.to_string());
+    }
+    Ok(())
 }
 
