<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="سیلا — تبدیل متن به گفتار"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="در حال بررسی مدل‌ها..."
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:tabGravity="fill"
        app:tabMode="fixed" />

    <!-- تب خواندن (پیش‌فرض) -->
    <ScrollView
        android:id="@+id/readTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="متن برای خواندن">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:minLines="4"
                    android:text="سلام! این صدای مدل سیلا روی گوشی شماست." />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playStopButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:text="▶ پخش صدا"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveWavButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:text="ذخیره صدا (WAV) در دانلودها" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="مدل فارسی فعال"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/persianModelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioCillaMini"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="سیلا مینی (سریع)" />

                <RadioButton
                    android:id="@+id/radioCillaLite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="سیلا لایت (باکیفیت)" />
            </RadioGroup>

            <TextView
                android:id="@+id/voiceFaLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="گوینده فارسی"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/voiceFaSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="گوینده انگلیسی (Phonon)"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/voiceEnSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tempLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="دما (Temperature): 0.70"
                android:textStyle="bold" />

            <com.google.android.material.slider.Slider
                android:id="@+id/tempSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="0.05"
                android:value="0.7"
                android:valueFrom="0.0"
                android:valueTo="1.5" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Seed"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/randomSeedCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="تصادفی" />

                <EditText
                    android:id="@+id/seedInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:digits="0123456789"
                    android:enabled="false"
                    android:hint="مثلاً 42"
                    android:inputType="number"
                    android:text="42" />
            </LinearLayout>

            <TextView
                android:id="@+id/metricsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text=""
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- تب تنظیمات -->
    <ScrollView
        android:id="@+id/settingsTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Cilla Mini -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="مدل فارسی سریع — سیلا مینی (Cilla Mini)"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadFaButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="دانلود سیلا مینی (~۱۱۲ مگابایت)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectFaFolderButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="انتخاب پوشه سیلا مینی" />

            <TextView
                android:id="@+id/modelFaStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="بررسی نشده"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider" />

            <!-- Cilla Lite -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="مدل فارسی باکیفیت — سیلا لایت (Cilla Lite 100M)"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="مدل ۱۰۰ میلیونی mehdi-hf/cilla-lite با کیفیت طبیعی‌تر و کلون صدا. تبدیل config.yaml و tokenizer.model به‌صورت خودکار روی گوشی انجام می‌شود."
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadLiteButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="دانلود سیلا لایت با توکن HF (~۴۴۰ مگابایت)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectLiteFolderButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="انتخاب پوشه سیلا لایت" />

            <TextView
                android:id="@+id/modelLiteStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="بررسی نشده"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider" />

            <!-- Voice Cloning -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="کلون صدا (Voice Cloning)"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cloneStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="از روی ۳ تا ۱۰ ثانیه صدای نمونه (میکروفون یا فایل صوتی) گوینده اختصاصی برای سیلا لایت یا سیلا مینی بسازید."
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cloneRecordButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🎙 ضبط صدا با میکروفون برای کلون" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clonePickFileButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="📁 انتخاب فایل صوتی (WAV/MP3/M4A/OGG) برای کلون" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider" />

            <!-- English Phonon -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="مدل انگلیسی (Phonon 31M)"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadEnButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="دانلود مدل انگلیسی" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadPhononVoicesButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="دانلود صداهای انگلیسی (Phonon Voices)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectEnFolderButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="انتخاب پوشه مدل انگلیسی" />

            <TextView
                android:id="@+id/modelEnStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="بررسی نشده"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider" />

            <!-- Voices management -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="مدیریت صداها (Voices)"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="هر فایل safetensors به‌طور خودکار در مدل سازگار خودش (سیلا مینی، سیلا لایت یا فونون) قرار می‌گیرد."
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importVoicesButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="انتخاب پوشه صدا (safetensors)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteVoicesButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="حذف همه صداها" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="حذف از حافظه برنامه"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="مدل‌ها و صداهای ذخیره‌شده در حافظه داخلی برنامه پاک می‌شوند (فایل‌های روی گوشی دست‌نخورده می‌مانند)."
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteModelsButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="حذف مدل‌ها و صداها" />

            <TextView
                android:id="@+id/storageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="کپی‌رایت و مجوزها"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="مدل‌های فارسی Cilla Mini و Cilla Lite (huggingface.co/mehdi-hf/cilla-lite) توسط Oncilla AI (oncillaai.com)\nNon-commercial model (CC BY-NC 4.0)\n\nمدل انگلیسی Phonon و مجموعه صداهای Phonon Voices (huggingface.co/gradium/phonon-voices) توسط Gradium (gradium.ai)\nApache 2.0\n\nموتور اجرا: xn-ptts (github.com/gradium-ai/xn-ptts)"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
